# QUESTFLOW AI – Environment Configuration
# Google for Developers × PromptWars 2026 Hackathon

# Application Server
PORT=3001
NODE_ENV=development

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left empty, QuestFlow automatically uses its built-in local heuristics reasoning core
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (Optional - for live Gmail and Drive sync)
# Configure at Google Cloud Console: https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Gamification & Safety Defaults
DEMO_MODE=true
AUTO_APPROVE_SAFE_ACTIONS=false
